# SPDX-FileCopyrightText: 2026 Deakin University and the LOTUS authors
# SPDX-License-Identifier: MIT
#
# LOTUS released run: Gemma3-270M backbone (paper Table 2, "LOTUS 270M").
#
# REFERENCE ONLY. The launchers do NOT source this file; every value below
# was copied from the launcher that produced the released checkpoint:
#   Phase 1 : bashfiles/joint_phase1/mlp/train_mlp_joint_phase1_proc_synth_freq.sh
#   Phase 2 : bashfiles/joint_phase2/joint5/train_joint5_ours.sh
#   LoRA    : stages_with_lora in curriculum_learning.py (_enable_lora_if_needed)
# Lines where the launcher and the paper disagree carry a "# paper ... says" note.

# ── backbone ────────────────────────────────────────────────────────────────
LLM_ID=google/gemma-3-270m
MODEL=OpenTSLMSPFixPos2D
LLM_DTYPE=auto                      # argparse default (bf16 where supported); launcher does not pass --llm_dtype

# ── time-series encoder / decoder ───────────────────────────────────────────
ENC_DEC_TYPE=mlp                    # --enc_dec_type mlp
MLP_ENC_HIDDEN_DIM=64               # --mlp_enc_hidden_dim
MLP_ENC_FF_DIM=256                  # --mlp_enc_ff_dim
MLP_DEC_HIDDEN_DIM=64               # --mlp_dec_hidden_dim
MLP_DEC_FF_DIM=256                  # --mlp_dec_ff_dim
USE_FREQ_EMBED=1                    # --use_freq_embed (rfft frequency branch) in BOTH phases
FREQ_MODE=linear                    # argparse default; launcher does not pass --freq_mode
PATCH_SIZE=32                       # --patch_size 32
PE_TYPE=sincos                      # --pe_type sincos
PE_BASE_T=10000                     # argparse default; launcher does not pass --pe_base_t
PE_BASE_C_PHASE1=10                 # --pe_base_c "${PE_BASE_C:-10}" in the Phase-1 launcher
PE_BASE_C_PHASE2=10                 # --pe_base_c 10 in the Phase-2 launcher
LLM_MV_POSITION_IDS=1               # argparse default ON (--llm_mv_position_ids); launcher passes neither flag

# ── Phase 1 (forecast-grounded pre-training) ────────────────────────────────
PHASE1_STAGE=joint_phase1_extend_balanced
PHASE1_LORA=none                    # stage is not in stages_with_lora -> frozen LLM, encoder/projector/decoder trained
PHASE1_NUM_EPOCHS=100               # --num_epochs 100 (best-val checkpoint is the one released)
PHASE1_BATCH_SIZE=16                # --batch_size 16 (per device)
PHASE1_VAL_BATCH_SIZE=8             # --val_batch_size 8
PHASE1_GRAD_ACCUM=1                 # --grad_accum_steps 1
PHASE1_NODES=2                      # #SBATCH --nodes=2
PHASE1_GPUS_PER_NODE=4              # torchrun --nproc_per_node=4
PHASE1_EFFECTIVE_BATCH=128          # 2 nodes x 4 GPUs x 16 x 1  (paper Table 7: 2x4 GPUs, batch 16, eff. 128 -- agrees)
# Task-sampler weights chronos_uv : synthetic : tsqa : m4 (paper Table 2: 1:2:1:1 -- agrees)
TASK_WEIGHT_CHRONOS_UV=1.0
TASK_WEIGHT_SYNTHETIC=2.0
TASK_WEIGHT_TSQA=1.0
TASK_WEIGHT_M4=1.0
PHASE1_CHRONOS_FLAGS="--chronos_window_sampling random --chronos_random_samples_per_row 25 --chronos_univariate --use_processor"
PHASE1_CKPT_DIR=results/sincos_patch32_mlp/gemma_3_270m/OpenTSLMSPFixPos2D/joint_phase1_extend_balanced_freq

# ── Phase 2 (downstream adaptation) ─────────────────────────────────────────
PHASE2_STAGE=joint_phase2_downstream
PHASE2_LORA_R=4                     # stages_with_lora["joint_phase2_downstream"] = (4, 8); the Phase-1 ckpt carries no adapter
PHASE2_LORA_ALPHA=8
PHASE2_NUM_EPOCHS=20                # --num_epochs 20 (early stopping below)
PHASE2_BATCH_SIZE=1                 # --batch_size 1
PHASE2_VAL_BATCH_SIZE=1             # --val_batch_size 1
PHASE2_GRAD_ACCUM=16                # --grad_accum_steps 16
PHASE2_MAX_TOKENS_PER_BATCH=600     # --max_tokens_per_batch 600
PHASE2_MSE_ALPHA=1.0                # --mse_alpha 1.0
PHASE2_NODES=1                      # #SBATCH --nodes=1 --gpus=4
PHASE2_GPUS_PER_NODE=4              # torchrun --nproc_per_node=4
#   NOTE: train_joint5_ours_1b.sh records that the PUBLISHED 270M Phase-2 run
#   actually trained on 8 GPUs over 2 nodes (effective batch 128); the current
#   launcher as written gives world size 4 (effective batch 64).
PHASE2_COT_ONLY=1
PHASE2_INCLUDE_ECG=1
PHASE2_INCLUDE_PAMAP2=1
PHASE2_COT_TASKS=har,sleep,ecg,pamap2,timemqa
PHASE2_COT_MIX=balanced_all
PHASE2_BALANCE_TARGET=40000
PHASE2_SELECT_BY_GEN=1
PHASE2_GEN_EM_N=192
PHASE2_EARLY_STOP_PAT=8
PHASE2_EXTRA_FLAGS="--windows_per_col_train 0 --dataloader_workers 0 --save_every_n_steps 800 --gradient_checkpointing --warm_start_from pretrained"

# ── warm start (released Phase-1 checkpoint, HF hiepnh137/LangTimeFoundationModel) ──
WARM_START_DIR=joint_phase1_extend_balanced_freq
WARM_START_PRETRAINED_CKPT="${FTS_PRETRAINED_DIR:-}/joint_phase1_extend_balanced_freq/checkpoints/best_model.pt"
RESULTS_BASE_DIR="${FTS_RESULTS_ROOT:-}_joint5_ours"
