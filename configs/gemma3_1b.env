# SPDX-FileCopyrightText: 2026 Deakin University and the LOTUS authors
# SPDX-License-Identifier: MIT
#
# LOTUS released run: Gemma3-1B backbone (paper Table 2, "LOTUS 1B").
#
# REFERENCE ONLY. The launchers do NOT source this file; every value below
# was copied from the launcher that produced the released checkpoint:
#   Phase 1 : bashfiles/joint_phase1/trans_enc/train_trans_joint_phase1_extbal_lora_r8_freq_mvpos_gemma3_1b.sh
#   Phase 2 : bashfiles/joint_phase2/joint5/train_joint5_ours_1b.sh
#   LoRA    : stages_with_lora in curriculum_learning.py (_enable_lora_if_needed)
# Lines where the launcher and the paper disagree carry a "# paper ... says" note.

# ── backbone ────────────────────────────────────────────────────────────────
LLM_ID=google/gemma-3-1b-pt
MODEL=OpenTSLMSPFixPos2D
LLM_DTYPE_PHASE1=auto               # argparse default; Phase-1 launcher does not pass --llm_dtype
LLM_DTYPE_PHASE2=bf16               # --llm_dtype bf16 (explicit in the Phase-2 launcher)

# ── time-series encoder / decoder (transformer, "1.5x" sizing) ──────────────
ENC_DEC_TYPE=transformer            # --enc_dec_type transformer
TRANS_ENC_DIM=192                   # --trans_enc_dim
TRANS_ENC_NUM_LAYERS=6              # --trans_enc_num_layers
TRANS_ENC_NUM_HEADS=8               # --trans_enc_num_heads (code default is 12; must be passed)
TRANS_ENC_FF_DIM=896                # --trans_enc_ff_dim
TRANS_DEC_DIM=192                   # --trans_dec_dim
TRANS_DEC_NUM_LAYERS=4              # --trans_dec_num_layers
TRANS_DEC_NUM_HEADS=8               # --trans_dec_num_heads
TRANS_DEC_FF_DIM=896                # --trans_dec_ff_dim
USE_FREQ_EMBED=1                    # --use_freq_embed in BOTH phases
FREQ_MODE=linear                    # argparse default
PATCH_SIZE=32                       # --patch_size 32
PE_TYPE=sincos                      # --pe_type sincos
PE_BASE_T=10000                     # argparse default
PE_BASE_C_PHASE1=10000              # argparse default; Phase-1 launcher does not pass --pe_base_c
PE_BASE_C_PHASE2=10                 # --pe_base_c 10 (deliberate, matches the 270M run; see launcher comment)
LLM_MV_POSITION_IDS=1               # --llm_mv_position_ids passed explicitly in Phase 1 (default ON in Phase 2)
RUN_SUFFIX=mvpos                    # --run_suffix mvpos (Phase-1 results dir suffix)

# ── Phase 1 (forecast-grounded pre-training) ────────────────────────────────
PHASE1_STAGE=joint_phase1_extend_balanced_lora_r8
PHASE1_LORA_R=8                     # stages_with_lora["joint_phase1_extend_balanced_lora_r8"] = (8, 16)
PHASE1_LORA_ALPHA=16
PHASE1_NUM_EPOCHS=100               # --num_epochs 100
PHASE1_BATCH_SIZE=8                 # --batch_size 8 (per device)
PHASE1_VAL_BATCH_SIZE=8             # --val_batch_size 8
PHASE1_GRAD_ACCUM=1                 # --grad_accum_steps 1
PHASE1_NODES=4                      # #SBATCH --nodes=4
PHASE1_GPUS_PER_NODE=4              # torchrun --nproc_per_node=4
PHASE1_EFFECTIVE_BATCH=128          # 4 nodes x 4 GPUs x 8 x 1  (paper Table 7: 4x4 GPUs, batch 8, eff. 128 -- agrees)
# Task-sampler weights chronos_uv : synthetic : tsqa : m4
TASK_WEIGHT_CHRONOS_UV=1.0
TASK_WEIGHT_SYNTHETIC=1.0           # paper Table 2 says 2 (1:2:1:1); launcher default is 1:1:0.75:0.75 -- export TASK_WEIGHT_* to override
TASK_WEIGHT_TSQA=0.75               # paper Table 2 says 1
TASK_WEIGHT_M4=0.75                 # paper Table 2 says 1
PHASE1_CHRONOS_FLAGS="--chronos_window_sampling random --chronos_random_samples_per_row 25 --chronos_univariate --use_processor"
PHASE1_SYNTHETIC_DATA_DIR="${FTS_SYNTHETIC_DIR:-}:${FTS_TSUMM_DIR:-}"   # synthetic MV corpus + TSUMM
PHASE1_CKPT_DIR=results/sincos_patch32/gemma_3_1b_pt/OpenTSLMSPFixPos2D/joint_phase1_extend_balanced_lora_r8_freq_mvpos

# ── Phase 2 (downstream adaptation) ─────────────────────────────────────────
PHASE2_STAGE=joint_phase2_downstream
PHASE2_LORA_R=8                     # stage default is (4, 8) but the warm-start code inherits the Phase-1 adapter (r=8, alpha=16)
PHASE2_LORA_ALPHA=16
PHASE2_NUM_EPOCHS=20                # --num_epochs 20
PHASE2_BATCH_SIZE=1                 # --batch_size 1
PHASE2_VAL_BATCH_SIZE=1             # --val_batch_size 1
PHASE2_GRAD_ACCUM=16                # --grad_accum_steps 16
PHASE2_MAX_TOKENS_PER_BATCH=600     # --max_tokens_per_batch 600
PHASE2_MSE_ALPHA=1.0                # --mse_alpha 1.0
PHASE2_NODES=1                      # #SBATCH --nodes=1 --gpus=8
PHASE2_GPUS_PER_NODE=8              # NPROC=8 -> effective batch 8 x 1 x 16 = 128
PHASE2_COT_ONLY=1
PHASE2_INCLUDE_ECG=1
PHASE2_INCLUDE_PAMAP2=1
PHASE2_COT_TASKS=har,sleep,ecg,pamap2,timemqa
PHASE2_COT_MIX=balanced_all
PHASE2_BALANCE_TARGET=40000
PHASE2_SELECT_BY_GEN=1
PHASE2_GEN_EM_N=192
PHASE2_EARLY_STOP_PAT=8

# ── warm start (released Phase-1 checkpoint, HF hiepnh137/LangTimeFoundationModel) ──
WARM_START_DIR=gemma_3_1b_pt_joint_phase1_extend_balanced_lora_r8_freq_mvpos
WARM_START_PRETRAINED_CKPT="${FTS_PRETRAINED_DIR:-}/gemma_3_1b_pt_joint_phase1_extend_balanced_lora_r8_freq_mvpos/checkpoints/best_model.pt"
RESULTS_BASE_DIR="${FTS_RESULTS_ROOT:-}_joint5_ours_1b"
