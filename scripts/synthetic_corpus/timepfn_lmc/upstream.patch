+def _sample_then_generate(seed, max_kernels, min_channels, max_channels, min_length, max_length,
+                          dirichlet_min, dirichlet_max, weibull_shape, weibul_scale):
+    """Per-sample wrapper: draw (C, L) once, then call generate_time_series with those.
+
+    A per-call np.random.seed is needed because LMC_Synth uses the legacy global RNG.
+    """
+    rng = np.random.default_rng(seed)
+    np.random.seed(int(rng.integers(0, 2**31 - 1)))
+    C = int(rng.integers(min_channels, max_channels + 1))
+    L = int(rng.integers(min_length, max_length + 1))
+    return generate_time_series(
+        max_kernels=max_kernels, num_channels=C, length=L,
+        dirichlet_min=dirichlet_min, dirichlet_max=dirichlet_max,
+        weibull_shape=weibull_shape, weibul_scale=weibul_scale,
+    )
+
